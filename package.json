{
  "name": "bharosa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "esbuild server/rules.ts --format=esm --outfile=.test-build/rules.mjs --bundle --log-level=error && node --test \"tests/**/*.test.mjs\"",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"{src,api,server,tests}/**/*.{ts,tsx,mjs,json,css}\"",
    "check": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^3.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.9.7",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.3",
    "vite-plugin-pwa": "^0.20.5"
  }
}
